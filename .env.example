# Copie para .env e preencha. NUNCA versione o .env.
# cp .env.example .env

# --- Confluent Cloud ---
CONFLUENT_ENV_NAME=desafio-final
CONFLUENT_CLUSTER_NAME=desafio-basic
CONFLUENT_CLOUD=aws
CONFLUENT_REGION=us-east-1

# Service accounts (menor privilégio: uma escreve, outra lê)
SA_PRODUCER_NAME=desafio-producer
SA_CONSUMER_NAME=desafio-consumer

# Preenchidos após a criação (IDs e chaves gerados pelo setup)
CONFLUENT_ENV_ID=
CONFLUENT_CLUSTER_ID=
SA_PRODUCER_ID=
KAFKA_API_KEY=
KAFKA_API_SECRET=
SCHEMA_REGISTRY_URL=
SCHEMA_REGISTRY_API_KEY=
SCHEMA_REGISTRY_API_SECRET=

# Cloud API key (Metrics API). Criada com: confluent api-key create --resource cloud
CLOUD_API_KEY=
CLOUD_API_SECRET=

# --- Postgres (Neon) ---
PG_HOST=
PG_PORT=5432
PG_DB=
PG_ADMIN_USER=
PG_ADMIN_PASSWORD=

# Usuário dedicado ao CDC (permissão mínima de replicação)
CDC_USER=cdc_user
CDC_PASSWORD=

# --- Parâmetros do pipeline ---
TOPIC_PREFIX=desafio
SEED=42
